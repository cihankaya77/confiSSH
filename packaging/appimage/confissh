#!/bin/sh
set -eu

APP_ROOT=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}

if ! command -v python3 >/dev/null 2>&1; then
    echo "ConfiSSH requires Python 3.10 or newer." >&2
    exit 1
fi
if ! python3 -c 'import sys; assert sys.version_info >= (3, 10); import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' >/dev/null 2>&1; then
    echo "ConfiSSH requires Python 3.10+, PyGObject, and GTK 3." >&2
    echo "Ubuntu/Debian: sudo apt install python3 python3-gi gir1.2-gtk-3.0 openssh-client" >&2
    echo "Fedora/RHEL: sudo dnf install python3 python3-gobject gtk3 openssh-clients" >&2
    exit 1
fi
if ! command -v ssh >/dev/null 2>&1; then
    echo "ConfiSSH requires an OpenSSH client." >&2
    exit 1
fi

export PYTHONPATH="$APP_ROOT/usr/lib/confissh${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m confissh.app "$@"
